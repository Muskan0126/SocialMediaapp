server {

    listen 80;

    server_name YOUR_DOMAIN_OR_IP;

    location = /favicon.ico {
        access_log off;
        log_not_found off;
    }

    location /static/ {
        alias /home/ubuntu/SocialMediaapp/staticfiles/;
    }

    location /media/ {
        alias /home/ubuntu/SocialMediaapp/media/;
    }

    location / {
        include proxy_params;
        proxy_pass http://unix:/home/ubuntu/SocialMediaapp/gunicorn.sock;
    }

}